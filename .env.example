# Copy to .env for local dev
DATABASE_URL=postgres://fajr:fajr@localhost:5440/fajr
NODE_ENV=development
API_PORT=3001
PUBLIC_API_URL=http://localhost:3001

# REQUIRED in production. adapter-node derives its origin from this, and
# SvelteKit's cross-site POST protection compares the Origin header against it.
# Get it wrong behind Caddy and every form submission 403s.
ORIGIN=http://localhost:5173

# Object storage. S3-compatible: MinIO locally, Cloudflare R2 in production.
# Production R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=fajr
STORAGE_SECRET_ACCESS_KEY=fajrfajr
STORAGE_BUCKET=fajr-media
# Public base URL for stored objects. In production this is the CDN in front
# of the bucket, which is also what does the resizing.
STORAGE_PUBLIC_URL=http://localhost:9000/fajr-media

# SMS. `console` prints instead of spending money; `alpha` is a BD gateway.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=

# Online payments. Unset means COD and manual bKash only, which is a valid
# launch configuration in BD.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Facebook Conversions API. Server-side events survive ad blockers and iOS
# privacy settings, which the browser pixel alone does not.
FB_PIXEL_ID=
FB_CAPI_TOKEN=
FB_CAPI_TEST_CODE=

# Couriers, in preference order. Unset falls back to `mock`, which accepts
# every parcel — fine for development, obviously not for a real shop.
COURIERS=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# COD fraud check. Unset means every order routes to the verification queue,
# which is exactly what should happen when the lookup is unavailable.
FRAUD_PROVIDER=
FRAUD_API_URL=
FRAUD_API_KEY=

# Marketing site (apps/marketing) — its own database, not a shop's.
LEADS_DATABASE_URL=postgres://user:pass@host:5432/fajr_leads
LEADS_EXPORT_TOKEN=
# Demo shop credentials handed out after the KYC form.
DEMO_BASE_HOST=demo.fajr.shop
DEMO_EMAIL=
DEMO_PASSWORD=
# Optional: enquiries are POSTed here as well as stored.
ENQUIRY_WEBHOOK_URL=
