# Infrastructure only. Everything about the shop itself (name, branding, VAT, payment,
# courier and SMS accounts) is set from the admin dashboard, not here.

# Postgres. The role must not be a superuser, or row-level security is bypassed.
FAJR_DATABASE_URL=postgres://fajr_shop:fajr_shop@localhost:5432/fajr_shop?sslmode=disable

# Where the API listens.
FAJR_HTTP_ADDR=127.0.0.1:8080

# Browser origins allowed to call the API directly, comma-separated. Must be set; may be empty.
FAJR_CORS_ORIGINS=http://localhost:5173

# Proxies allowed to report the visitor's address in X-Forwarded-For, as CIDRs, comma-separated:
# Caddy and the web app's server. Must be set; may be empty when nothing sits in front.
FAJR_TRUSTED_PROXIES=127.0.0.1/32,::1/128
