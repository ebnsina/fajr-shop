{$DOMAIN} {
	encode zstd gzip

	# Caddy terminates TLS and obtains the certificate itself. The app is told
	# the real scheme and host, because adapter-node cannot see past the proxy.
	reverse_proxy web:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}

	# Build output is content-hashed, so it can be cached forever.
	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format json
	}
}
