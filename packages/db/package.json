{
  "name": "@fajr/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "studio": "drizzle-kit studio",
    "check": "tsc --noEmit",
    "seed": "tsx src/seed.ts",
    "seed:demo": "node --experimental-strip-types src/seed-demo.ts",
    "seed:tech": "node --experimental-strip-types src/seed-tech.ts",
    "seed:vertical": "node --experimental-strip-types src/seed/run.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.5",
    "@node-rs/argon2": "^2.0.2",
    "@fajr/core": "workspace:*"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
